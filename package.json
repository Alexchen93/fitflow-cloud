{
  "name": "fitflow-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run lint && npm run test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply fitflow-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fitflow-db --remote",
    "cf:typegen": "wrangler types worker/env.d.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.9.12",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.14",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "oxlint": "^1.32.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.3",
    "wrangler": "^4.45.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
